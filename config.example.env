# scratchdock configuration.
#
# Copy to the plugin's config directory and edit:
#   cp config.example.env "$(herdr plugin config-dir mvaios.scratchdock)/config.env"
#
# Every key can also be set as an environment variable with a SCRATCHDOCK_ prefix.

# Agent statuses that open the dock. Comma-separated; empty disables auto-open
# and leaves the dock to the toggle action.
OPEN_ON=working

# Agent statuses that close it again. Empty keeps the dock up after the agent
# stops, which is usually when you want to read what it left behind.
# Example: CLOSE_ON=idle,done
CLOSE_ON=

# Agents to dock for, or * for every agent that has a resolver. An agent without
# one docks nothing rather than something else's directory.
#   claude - the session scratchpad, /tmp/claude-<uid>/<slug>/<session>/scratchpad
#   codex  - the thread's images, ~/.codex/generated_images/<thread-id>
AGENTS=claude,codex

# Which side the dock opens on: right or down.
DIRECTION=right

# 1 to focus the dock when it opens. Off by default: the dock appearing should
# not steal the keystroke you were typing into the agent.
FOCUS=0

# Override the Claude scratchpad root. Default: /tmp/claude-<uid>
SCRATCHPAD_ROOT=

# Override Codex's home. Default: ~/.codex
CODEX_HOME=

# Pair a Codex dock with the repo's uncommitted changes (git status), since
# images are the only output Codex keeps per thread. 0 for images alone.
GIT_CHANGES=1

# Which viewer runs in the dock pane.
#   builtin     - the bundled live tree, newest first (default)
#   file-viewer - the herdr-file-viewer plugin: preview pane, manual refresh
#   <argv>      - any command, run with the scratchpad as its working directory
VIEWER=builtin
